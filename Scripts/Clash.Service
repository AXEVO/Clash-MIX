#!/system/bin/sh
Module_dir="/data/adb/modules/Clash"
sdcard_dir="/sdcard/Android/Clash"
script_dir="$Module_dir/Scripts"
tproxy_log="$sdcard_dir/tproxy日志.txt"
core_log="$sdcard_dir/内核日志.txt"

start_core() {
    if ! (ps -ef | grep -- 'Clash.Core -d' | grep -vE 'inotifyd|grep') > /dev/null ; then
        nohup "$Module_dir/Proxy/Clash.Core" -d "$Module_dir/Proxy" > "$core_log" 2>&1 &
        sleep 1
        echo "Clash内核已启动"
    else
        echo "Clash内核正在运行中"
    fi
}

stop_core() {
    if (ps -ef | grep -- 'Clash.Core -d' | grep -vE 'inotifyd|grep') > /dev/null ; then
        pid=$(pgrep -f 'Clash.Core -d')
        kill -15 $pid
        echo "Clash内核已关闭"
    else
        echo "Clash内核未在运行"
    fi
}

start_tproxy() {
    if [ ! -x "$script_dir/tproxy.sh" ]; then
        echo "tproxy.sh 不存在或不可执行"
        return 1
    fi

    "$script_dir/tproxy.sh" -d "$script_dir" start >> "$tproxy_log" 2>&1
    return $?
}

stop_tproxy() {
    if [ -x "$script_dir/tproxy.sh" ]; then
        "$script_dir/tproxy.sh" -d "$script_dir" stop >> "$tproxy_log" 2>&1
    fi
}

start() {
    start_core || return 1

    if start_tproxy; then
        echo "TPROXY规则已加载"
    else
        echo "TPROXY规则加载失败，请查看$tproxy_log"
        return 1
    fi
}

stop() {
    stop_tproxy
    stop_core
    echo "已尝试清理TPROXY规则"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    *)
        echo "只能使用start|stop两个参数控制内核启动或停止"
        exit 1
        ;;
esac
