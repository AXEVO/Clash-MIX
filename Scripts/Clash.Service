#!/system/bin/sh
Module_dir="/data/adb/modules/Clash"
sdcard_dir="/sdcard/Android/Clash"
core_path="$Module_dir/Proxy/Clash.Core"
log_path="$sdcard_dir/内核日志.txt"
tun_name="Meta"

Core_Check() {
    pgrep -f "Clash.Core -d" > /dev/null
}

Tun_Check() {
    ip link show "$tun_name" > /dev/null 2>&1
}

start() {
    if Core_Check; then
        echo "Clash内核正在运行，不执行启动命令"
        return 2
    fi

    backup_log_path="$sdcard_dir/旧内核日志备份.txt"
    rm -f "$backup_log_path"
    if [ -f "$log_path" ]; then
        cp -f "$log_path" "$backup_log_path"
    fi

    nohup "$core_path" -d "$Module_dir/Proxy" > "$log_path" 2>&1 &

    for i in 1 2 3 4 5; do
        if Core_Check && Tun_Check; then
            break
        fi
        sleep 1
    done

    if ! Core_Check || ! Tun_Check; then
        echo "Clash内核启动异常，请检查日志"
        return 1
    fi

    # 添加规则
    iptables -C FORWARD -i "$tun_name" -j ACCEPT 2>/dev/null || iptables -I FORWARD -i "$tun_name" -j ACCEPT
    iptables -C FORWARD -o "$tun_name" -j ACCEPT 2>/dev/null || iptables -I FORWARD -o "$tun_name" -j ACCEPT
    ip6tables -C FORWARD -i "$tun_name" -j ACCEPT 2>/dev/null || ip6tables -I FORWARD -i "$tun_name" -j ACCEPT
    ip6tables -C FORWARD -o "$tun_name" -j ACCEPT 2>/dev/null || ip6tables -I FORWARD -o "$tun_name" -j ACCEPT

    echo "Clash内核已启动"
    return 0
}

stop() {
    if ! Core_Check; then
        echo "Clash内核未在运行，不执行停止命令"
        return 2
    fi

    pkill -15 -f "Clash.Core -d"

    # 等待优雅退出（最多5秒）
    for i in 1 2 3 4 5; do
        if ! Core_Check && ! Tun_Check; then
            break
        fi
        sleep 1
    done

    # 若仍未退出，强制结束
    if Core_Check || Tun_Check; then
        pkill -9 -f "Clash.Core -d"

        # 再等待（最多5秒）
        for i in 1 2 3 4 5; do
            if ! Core_Check && ! Tun_Check; then
                break
            fi
            sleep 1
        done
    fi

    # 删除规则
    iptables -D FORWARD -i "$tun_name" -j ACCEPT 2>/dev/null
    iptables -D FORWARD -o "$tun_name" -j ACCEPT 2>/dev/null
    ip6tables -D FORWARD -i "$tun_name" -j ACCEPT 2>/dev/null
    ip6tables -D FORWARD -o "$tun_name" -j ACCEPT 2>/dev/null

    # 最终判定
    if ! Core_Check && ! Tun_Check; then
        echo "Clash内核已停止"
        return 0
    fi

    echo "Clash内核停止异常"
    return 1
}

case "$1" in
    start)
        start
        exit $?
        ;;
    stop)
        stop
        exit $?
        ;;
    *)
        echo "只能使用start|stop两个参数控制内核"
        exit 1
        ;;
esac
