#!/system/bin/sh
Module_dir="/data/adb/modules/Clash"
sdcard_dir="/sdcard/Android/Clash"

start() {
    
    if ! (ps -ef | grep -- 'Clash.Core -d' | grep -vE 'inotifyd|grep') > /dev/null ; then
        nohup $Module_dir/Proxy/Clash.Core -d $Module_dir/Proxy > $sdcard_dir/内核日志.txt 2>&1 &

        iptables -C FORWARD -i Meta -j ACCEPT 2>/dev/null || iptables -I FORWARD -i Meta -j ACCEPT
        iptables -C FORWARD -o Meta -j ACCEPT 2>/dev/null || iptables -I FORWARD -o Meta -j ACCEPT
        ip6tables -C FORWARD -i Meta -j ACCEPT 2>/dev/null || ip6tables -I FORWARD -i Meta -j ACCEPT
        ip6tables -C FORWARD -o Meta -j ACCEPT 2>/dev/null || ip6tables -I FORWARD -o Meta -j ACCEPT
        
        echo "Clash内核已启动"
    else
        echo "Clash内核正在运行中，不执行启动命令"
    fi
}

stop() {
    if (ps -ef | grep -- 'Clash.Core -d' | grep -vE 'inotifyd|grep') > /dev/null ; then
        pid=$(pgrep -f 'Clash.Core -d')
        kill -15 $pid

        iptables -D FORWARD -i Meta -j ACCEPT 2>/dev/null
        iptables -D FORWARD -o Meta -j ACCEPT 2>/dev/null
        ip6tables -D FORWARD -i Meta -j ACCEPT 2>/dev/null
        ip6tables -D FORWARD -o Meta -j ACCEPT 2>/dev/null

        echo "Clash内核已关闭并清除iptables规则"
    else
        echo "Clash内核未在运行，不执行停止命令"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    *)
        echo "只能使用start|stop两个参数控制内核启动或停止"
        exit 1
        ;;
esac
