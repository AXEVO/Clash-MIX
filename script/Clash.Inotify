#!/system/bin/sh
script_path=/data/adb/modules/Clash/script

events=$1
monitor_file=$3

if [ "$monitor_file" = "disable" ]; then
    if [ "$events" = "n" ]; then
        "$script_path/Proxy.sh" -d "$script_path" stop
    elif [ "$events" = "d" ]; then
        "$script_path/Proxy.sh" -d "$script_path" start
    fi
fi
