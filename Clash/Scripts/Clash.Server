#!/data/adb/magisk/busybox sh

Module_dir="/data/adb/modules/Clash"

start() {
    # 检查clash是否已经在运行
    if ! (ps -ef | grep -- 'clash -d' | grep -vE 'inotifyd|grep') > /dev/null ; then
        # 启动 clash 服务，并将日志保存到 log.txt
        nohup $Module_dir/Clash -d $Module_dir > $Module_dir/log.txt 2>&1 &
        # 配置防火墙规则，使用固定的网卡名 "Meta"
        iptables -I FORWARD -i Meta -j ACCEPT
        iptables -I FORWARD -o Meta -j ACCEPT

        echo "Clash内核已启动"
    else
        echo "Clash内核正在运行中，不执行启动命令"
    fi
}

stop() {
    if (ps -ef | grep -- 'clash -d' | grep -vE 'inotifyd|grep') > /dev/null ; then
        pid=`ps -ef | grep -- 'clash -d' | grep -vE 'inotifyd|grep' | awk -F ' ' '{print $2}'`
        kill -15 $pid

        # 清除tun的iptables
        while [ -n "$(iptables -L FORWARD -v -n --line-numbers | grep -E 'ACCEPT.*all')" ]; do
            rule_number=$(iptables -L FORWARD -v -n --line-numbers | grep -E 'ACCEPT.*all' | awk '{print $1}' | head -n 1)
            iptables -D FORWARD $rule_number
        done
        while [ -n "$(ip6tables -L FORWARD -v -n --line-numbers | grep -E 'ACCEPT.*all')" ]; do
            rule_number=$(ip6tables -L FORWARD -v -n --line-numbers | grep -E 'ACCEPT.*all' | awk '{print $1}' | head -n 1)
            ip6tables -D FORWARD $rule_number
        done

        echo "Clash内核已关闭"
    else
        echo "Clash内核未运行，不执行停止命令"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    *)
        echo "使用: $0 {start|stop}"
        exit 1
        ;;
esac
