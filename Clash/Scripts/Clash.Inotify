#!/data/adb/magisk/busybox sh
script_path=/data/adb/modules/Clash/Scripts

events=$1
monitor_file=$3

if [ "$monitor_file" = "disable" ]; then
    if [ "$events" = "n" ]; then
        $script_path/Clash.Service stop
    elif [ "$events" = "d" ]; then
        $script_path/Clash.Service start
    fi
fi
